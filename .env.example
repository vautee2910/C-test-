# Remote LLM gateway (OpenWebUI / OpenAI-compatible).
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# API key for the OpenWebUI gateway.
OI_API_KEY=

# Base URL of the gateway. Should end with /v1 (the client appends it if missing).
OI_BASE_URL=

# Model identifier to target on the gateway.
OI_MODEL=
